{
  "appId": "org.resonancelab.app",
  "productName": "RESONANCE LAB",
  "electronVersion": "33.2.1",
  "directories": { "output": "../../dist" },
  "files": ["main.cjs", "preload.cjs", "lib/**", "package.json", "app/**"],
  "extraResources": [{ "from": "ffmpeg", "to": "ffmpeg", "filter": ["**/*"] }],
  "asar": true,
  "compression": "normal",
  "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "signAndEditExecutable": false },
